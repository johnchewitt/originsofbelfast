# Belfast Rising — environment template.
# Copy to .env.local for development. Every VITE_ variable is compiled into
# the public JavaScript bundle: never put a secret here.

# Base path for the built site. Leave empty for the default "./", which works
# for GitHub Pages project sites (https://<user>.github.io/<repo>/).
VITE_BASE_PATH=

# Optional ArcGIS Location Platform API key. Not needed: the app uses basemaps,
# elevation and the OpenStreetMap 3D Buildings layer that load without a key.
# If you add one, restrict it by HTTP referrer to your site in the ArcGIS
# developer dashboard — it will be visible to anyone who opens the site.
VITE_ARCGIS_API_KEY=

# Portal used to resolve layer items (default https://www.arcgis.com).
VITE_ARCGIS_PORTAL_URL=

# Item id of the present-day buildings scene layer
# (default: Esri Living Atlas "OpenStreetMap 3D Buildings").
VITE_OSM_BUILDINGS_ITEM_ID=

# Serve the ArcGIS SDK runtime assets from the site itself instead of the Esri
# CDN. Run `npm run assets:copy` first (adds ~85 MB to the deployment).
VITE_ARCGIS_LOCAL_ASSETS=false

# Optional secure assistant backend (server/assistant-proxy). Only the URL goes
# here; the model API key lives in the backend's secret store.
VITE_ASSISTANT_ENDPOINT=

# Optional extra historic map services, as a JSON array using the schema in
# data/curated/historic-maps.json. Confirm each service's licence first.
# Example (single line):
# VITE_HISTORIC_MAP_SERVICES=[{"id":"osni-6inch-ed1-live","title":"OSNI six-inch Ed.1","kind":"service","service_type":"map-image","url":"https://example.org/arcgis/rest/services/OSNI_6inch_Ed1/MapServer","years":[1829,1846],"licence":"See OpenDataNI","attribution":"© Crown copyright, OSNI","is_historic_source":true,"enabled":true}]
VITE_HISTORIC_MAP_SERVICES=
